# AXIOM INVENTORY INTELLIGENCE — ENVIRONMENT CONFIGURATION
PORT=3000

# Active AI Provider: 'groq' | 'gemini' | 'openai'
AI_PROVIDER=groq

# Configurable Model
# Recommended Models:
# Groq:   llama-3.3-70b-versatile  or  llama-3.1-8b-instant
# Gemini: gemini-1.5-flash  or  gemini-1.5-pro
# OpenAI: gpt-4o-mini  or  gpt-4o
AI_MODEL=llama-3.3-70b-versatile

# API Keys (Provide the key corresponding to your chosen AI_PROVIDER)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

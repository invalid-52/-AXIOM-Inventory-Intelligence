# Environment configuration and secrets
.env
.env.*
!.env.example

# Node dependencies
node_modules/
dist/
build/
coverage/

# Logs and runtime files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System files
.DS_Store
Thumbs.db

# Storage backups, batch scripts and temporary artifacts
.storage-backup/
*.tmp
*.bak
*.bat
test_dom.html
scratch/

# Runtime local data & generated documents (auto-seeded on startup)
storage/*.json
storage/*.bak
storage/documents/*
!storage/.gitkeep
!storage/documents/.gitkeep
